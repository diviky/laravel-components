{
    "name": "diviky/laravel-components",
    "description": "Blade components.",
    "version": "2.2.0",
    "keywords": [],
    "license": "MIT",
    "type": "library",
    "authors": [],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "symfony/http-foundation": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "diviky/code-analysis": "^3.0",
        "livewire/livewire": "^3.4|^4.0",
        "spatie/laravel-translatable": "^6.0",
        "symfony/dom-crawler": "^6.0|^7.0"
    },
    "autoload": {
        "psr-4": {
            "Diviky\\LaravelComponents\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Diviky\\LaravelComponents\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "phpro/grumphp": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Diviky\\LaravelComponents\\Providers\\LaravelServiceProvider"
            ]
        }
    }
}
